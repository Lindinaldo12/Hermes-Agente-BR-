# ==========================================
# BOB AI X — variáveis de ambiente
# ==========================================
# Copie para .env e preencha. NUNCA commite o .env.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=seu_token_aqui

# --- Controle de acesso ---
# Seu ID do Telegram (numérico). Você é o master.
MASTER_ID=seu_id_aqui

# Admins extras, separados por vírgula. Deixe vazio se só você admin.
ADMIN_IDS=["id_admin"]

# Senha exigida em /senha para liberar comandos sensíveis.
ACCESS_PASSWORD=sua_senha

# --- IA ---
API_KEY=sua_chave_openrouter
API_URL=https://openrouter.ai/api/v1
MODEL_NAME=qwen/qwen-2.5-7b-instruct

# --- Opcional: chaves alternativas (usadas só se as acima faltarem) ---
# GROQ_API_KEY=
# TAVILY_API_KEY=
# GEMINI_API_KEY=
